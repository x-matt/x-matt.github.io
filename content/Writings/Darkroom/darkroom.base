filters:
  and:
    - file.inFolder("Writings/Darkroom")
formulas:
  last_modified: file.mtime.relative()
properties:
  formula.last_modified:
    displayName: updated
views:
  - type: table
    name: All
    groupBy:
      property: category
      direction: ASC
    order:
      - title
      - file.name
      - formula.last_modified
    sort:
      - property: date
        direction: ASC
    columnSize:
      file.name: 220
      note.title: 280
  - type: cards
    name: 💃 Model
    filters:
      and:
        - category == "model"
    limit: 30
    image: note.cover
    cardSize: 200
    imageAspectRatio: 1.42
  - type: table
    name: 🧔🏻Director
    filters:
      and:
        - category == "director"
    order:
      - title
      - file.name
      - formula.last_modified
  - type: table
    name: 🎬 Studio
    filters:
      and:
        - category == "studio"
    order:
      - title
      - file.name
      - formula.last_modified
  - type: table
    name: Blog
    filters:
      and:
        - category == "blog"
    groupBy:
      property: author
      direction: ASC
    order:
      - title
      - file.name
      - file.tags
      - date
      - formula.last_modified
    sort:
      - property: date
        direction: ASC
  - type: cards
    name: Blogger
    filters:
      and:
        - category == "blogger"
    sort:
      - property: date
        direction: ASC
    image: note.cover
    imageAspectRatio: 1.42
  - type: cards
    name: Image Cards
    filters:
      and:
        - "!cover.isEmpty()"
    order:
      - file.name
      - category
    limit: 30
    image: note.cover
    cardSize: 200
    imageAspectRatio: 1.42
