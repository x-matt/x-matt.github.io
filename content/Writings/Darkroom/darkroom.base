filters:
  and:
    - file.inFolder("Writings/Darkroom")
formulas:
  last_modified: file.mtime.relative()
properties:
  formula.last_modified:
    displayName: updated
views:
  - type: table
    name: 🎬 Studio
    filters:
      and:
        - category == "studio"
    order:
      - title
      - file.name
      - formula.last_modified
  - type: cards
    name: 🎥 Movie
    filters:
      and:
        - category == "movie"
    order: []
    image: note.cover
    imageAspectRatio: 0.6
    cardSize: 150
  - type: cards
    name: 🧔🏻 People
    filters:
      and:
        - category.containsAny("actor", "director")
    limit: 30
    image: note.cover
    cardSize: 200
    imageAspectRatio: 1.42
  - type: table
    name: All
    groupBy:
      property: category
      direction: ASC
    order:
      - title
      - file.name
      - formula.last_modified
    sort:
      - property: releasedate
        direction: ASC
    columnSize:
      file.name: 220
      note.title: 280
  - type: cards
    name: Blogger
    filters:
      and:
        - category == "blogger"
    order:
      - file.name
      - scoreStar
    sort: []
    image: note.cover
    imageAspectRatio: 1.42
  - type: table
    name: Blog
    filters:
      and:
        - category == "blog"
    groupBy:
      property: author
      direction: ASC
    order:
      - title
      - file.tags
      - file.name
      - releasedate
    sort:
      - property: releasedate
        direction: DESC
