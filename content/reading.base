filters:
  and:
    - file.inFolder("Writings")
    - domain == "book"
views:
  - type: cards
    name: Library
    order:
      - title
      - author
    image: note.cover
    imageAspectRatio: 0.7
  - type: table
    name: List
    order:
      - title
      - file.name
      - score
      - scoreStar
    sort:
      - property: score
        direction: DESC
    columnSize:
      note.title: 202
