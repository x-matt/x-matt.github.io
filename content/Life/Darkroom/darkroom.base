filters:
  and:
    - file.inFolder("Life/Darkroom")
formulas:
  last_modified: file.mtime.relative()
  section: |
    if(file.hasTag("model"), "model",
    if(file.hasTag("director"), "director",
    if(file.hasTag("studio"), "studio",
    if(file.hasTag("sm"), "sm",
    if(file.hasTag("piaopiao"), "piaopiao",
    if(file.hasTag("darkreaver"), "darkreaver", "other"))))))
properties:
  title:
    displayName: Title
  formula.last_modified:
    displayName: Updated
  formula.section:
    displayName: Section
views:
  - type: table
    name: All Docs
    groupBy:
      property: formula.section
      direction: ASC
    order:
      - title
      - file.name
      - formula.section
      - formula.last_modified
    sort:
      - property: date
        direction: ASC
      - property: title
        direction: DESC
      - property: formula.section
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 220
      note.title: 280
      formula.section: 160
  - type: cards
    name: 💃 Model
    filters:
      and:
        - file.hasTag("model")
    limit: 30
    image: note.cover
    cardSize: 200
    imageAspectRatio: 1.42
  - type: table
    name: 🧔🏻Director
    filters:
      and:
        - file.hasTag("director")
    order:
      - title
      - file.name
      - formula.last_modified
  - type: table
    name: 🎬 Studio
    filters:
      and:
        - file.hasTag("studio")
    order:
      - title
      - file.name
      - formula.last_modified
  - type: table
    name: 🪢SM
    filters:
      and:
        - file.hasTag("sm")
    order:
      - title
      - file.name
      - tags
      - date
      - formula.last_modified
    sort:
      - property: date
        direction: DESC
    columnSize:
      note.title: 280
  - type: table
    name: Piaopiao
    filters:
      and:
        - file.hasTag("piaopiao")
    order:
      - title
      - file.name
      - formula.last_modified
    sort:
      - property: date
        direction: ASC
  - type: table
    name: DarkReaver
    filters:
      and:
        - file.hasTag("darkreaver")
    order:
      - title
      - file.name
      - tags
    sort:
      - property: priority
        direction: ASC
    columnSize:
      note.title: 349
      file.name: 198
  - type: cards
    name: Image Cards
    filters:
      and:
        - "!cover.isEmpty()"
    limit: 30
    image: note.cover
    cardSize: 240
    imageAspectRatio: 1.42
