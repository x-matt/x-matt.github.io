filters:
  and:
    - file.inFolder("Work")
formulas:
  last_modified: file.mtime.relative()
properties:
  note.title:
    displayName: Title
  formula.last_modified:
    displayName: Updated
  note.domain:
    displayName: Category
  file.name:
    displayName: FileName
  note.tags:
    displayName: Tags
  note.status:
    displayName: Status
views:
  - type: table
    name: All Docs
    groupBy:
      property: type
      direction: ASC
    order:
      - title
      - file.name
      - tags
      - domain
      - formula.last_modified
    sort:
      - property: title
        direction: ASC
      - property: type
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 220
      note.title: 280
      formula.section: 160
  - type: table
    name: 📌 Projects
    filters:
      and:
        - type == "project"
        - status != "done"
    order:
      - title
      - file.name
      - tags
      - formula.last_modified
    sort:
      - property: tags
        direction: ASC
      - property: file.name
        direction: DESC
  - type: table
    name: 📂 Areas
    filters:
      and:
        - type == "area"
    groupBy:
      property: domain
      direction: ASC
    order:
      - title
      - file.name
      - tags
      - status
    sort:
      - property: title
        direction: DESC
      - property: tags
        direction: DESC
      - property: domain
        direction: ASC
    columnSize:
      file.name: 220
      note.title: 280
      file.domain: 160
  - type: table
    name: 📚 Resources
    filters:
      and:
        - type == "resource"
    order:
      - title
      - file.name
      - tags
      - domain
    sort:
      - property: title
        direction: ASC
  - type: table
    name: 🗃️ Archives
    filters:
      and:
        - status == "done"
    order:
      - title
      - file.name
      - tags
      - formula.last_modified
    sort:
      - property: title
        direction: ASC
  - type: table
    name: Express
    filters:
      and:
        - status == "expressing"
  - type: table
    name: Eis
    filters:
      and:
        - file.tags.contains("eis")
    groupBy:
      property: domain
      direction: ASC
    order:
      - file.name
      - status
      - domain
      - tags
  - type: table
    name: Sat
    filters:
      and:
        - file.tags.contains("sat")
    groupBy:
      property: domain
      direction: ASC
    order:
      - file.name
      - status
      - domain
      - tags
  - type: table
    name: Mivi
    filters:
      and:
        - file.tags.contains("mivi")
    order:
      - title
      - file.name
      - type
      - domain
  - type: table
    name: Algorithm
    filters:
      and:
        - domain == "algorithm"
    order:
      - title
      - file.name
      - type
      - file.mtime
    columnSize:
      note.title: 280
