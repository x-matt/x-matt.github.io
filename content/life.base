filters:
  and:
    - file.inFolder("Writings")
    - '!file.inFolder("Writings/Darkroom")'
formulas:
  last_modified: file.mtime.relative()
properties:
  formula.last_modified:
    displayName: updated
views:
  - type: table
    name: Recently
    order:
      - title
      - file.name
      - tags
      - domain
      - formula.last_modified
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 20
  - type: table
    name: D.Rev
    filters:
      and:
        - review == "daily"
    groupBy:
      property: domain
      direction: ASC
    order:
      - title
      - file.name
      - tags
      - formula.last_modified
  - type: table
    name: W.Rev
    filters:
      and:
        - review == "weekly"
    groupBy:
      property: domain
      direction: ASC
    order:
      - title
      - file.name
      - tags
      - formula.last_modified
  - type: table
    name: M.Rev
    filters:
      and:
        - review == "monthly"
    groupBy:
      property: domain
      direction: ASC
    order:
      - title
      - file.name
      - tags
      - formula.last_modified
  - type: table
    name: All
    groupBy:
      property: type
      direction: ASC
    order:
      - title
      - file.name
      - domain
      - tags
      - formula.last_modified
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 220
      note.title: 280
  - type: table
    name: 📌 Projects
    filters:
      and:
        - type == "project"
        - status != "done"
    groupBy:
      property: domain
      direction: ASC
    order:
      - title
      - file.name
      - tags
  - type: table
    name: 📂 Areas
    filters:
      and:
        - type == "area"
    groupBy:
      property: domain
      direction: ASC
    order:
      - title
      - file.name
      - tags
      - status
    sort:
      - property: tags
        direction: DESC
      - property: domain
        direction: ASC
    columnSize:
      file.name: 220
      note.title: 280
      file.domain: 160
  - type: table
    name: 📚 Resources
    filters:
      and:
        - type == "resource"
    groupBy:
      property: domain
      direction: ASC
    order:
      - title
      - file.name
      - tags
      - domain
    sort:
      - property: title
        direction: ASC
  - type: table
    name: 🗃️ Archives
    filters:
      and:
        - status == "done"
    groupBy:
      property: domain
      direction: ASC
    order:
      - title
      - file.name
      - tags
    sort:
      - property: title
        direction: ASC
  - type: table
    name: Express
    filters:
      and:
        - type == "wiki"
  - type: cards
    name: 🎥 Movie
    filters:
      and:
        - category == "movie"
    order:
      - title
    image: note.cover
    cardSize: 200
    imageAspectRatio: 0.6
  - type: cards
    name: 🧔🏻 People
    filters:
      and:
        - category.containsAny("director", "actor")
    order:
      - title
    image: note.cover
    imageAspectRatio: 0.75
