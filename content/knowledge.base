filters:
  and:
    - domain == "knowledge"
views:
  - type: table
    name: Computer Vision
    filters:
      and:
        - category.containsAny("geometry", "motion", "image-processing", "vision-task", "perception")
    groupBy:
      property: category
      direction: ASC
    order:
      - title
      - file.name
      - type
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
